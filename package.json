{
  "name": "pi-npm-security",
  "version": "0.0.2",
  "type": "module",
  "description": "Pi package for npm/supply-chain security workflows: Socket MCP bridge extension, npm security best-practices skill, and related tooling.",
  "license": "MIT",
  "author": "bodadotsh",
  "homepage": "https://github.com/bodadotsh/pi-npm-security#readme",
  "bugs": {
    "url": "https://github.com/bodadotsh/pi-npm-security/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bodadotsh/pi-npm-security.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "npm-security",
    "supply-chain",
    "socket",
    "mcp"
  ],
  "files": [
    "extensions",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx scripts/test-harness.ts",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@socketsecurity/mcp": "^0.0.20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "typebox": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.3.18",
    "typescript": "^5.9.3"
  }
}
